# 行尾规范化:哈希一致性测试要求 setup.command 在所有平台检出为相同字节
# setup.command 是 bash/Python 多态脚本,必须 LF
setup.command text eol=lf
npm/lib/setup.command text eol=lf
tokenplan_setup/_model_catalog.py text eol=lf

# Windows 批处理必须 CRLF
setup.bat text eol=crlf

# Python / 文档跟随平台默认
*.py text=auto
*.md text=auto
*.json text=auto

# 模型目录及其哈希文件:完整性契约要求所有平台检出为相同字节
# (models.json 经 CDN 分发的是仓库原始 LF 字节,models.json.sha256
# 记录的摘要与其对应;若检出时被转为 CRLF,哈希校验必然失败)
# 注意:必须放在 *.json 之后 —— gitattributes 后行覆盖前行
models.json text eol=lf
models.json.sha256 text eol=lf
